pipeline {
    agent any

    parameters {
        choice(
            name: 'action',
            choices: ['apply', 'destroy'],
            description: 'Terraform action'
        )
    }

    environment {
        ARM_SUBSCRIPTION_ID = credentials('azure_subscription_id')
        ARM_TENANT_ID       = credentials('azure_tenant_id')
        ARM_CLIENT_ID       = credentials('azure_client_id')
        ARM_CLIENT_SECRET   = credentials('azure_client_password')
    }

    stages {
        stage('Azure Login') {
            steps {
                sh '''
                    az login --service-principal \
                        --username $ARM_CLIENT_ID \
                        --password $ARM_CLIENT_SECRET \
                        --tenant $ARM_TENANT_ID
                    az account set --subscription $ARM_SUBSCRIPTION_ID
                '''
            }
        }
        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/virajt71/Entra_ID_Managment.git'
            }
        }
    }

    stages {
        when { expression { params.action == 'apply' } }
        stage('Terraform Init - Backend') {
            steps {
                script {
                    sh '''
                        cd backend
                        terraform init -reconfigure
                        terraform ${action} -auto-approve 
                    '''
                }
            }
        }
        stage('Terraform Init - Dev') {
            steps {
                script {
                    sh '''
                        pwd
                        cd envs/dev
                        terraform init -reconfigure
                        terraform ${action} -auto-approve 
                    '''
                }
            }
        }
        stage('Terraform Init - Staging') {
            steps {
                script {
                    sh '''
                        cd envs/staging
                        terraform init -reconfigure
                        terraform ${action} -auto-approve 
                    '''
                }
            }
        }
        stage('Terraform Init - Prod') {
            steps {
                script {
                    sh '''
                        cd envs/prod
                        terraform init -reconfigure
                        terraform ${action} -auto-approve
                    '''
                }
            }
        }
        stage('Terraform - users') {
            steps {
                script {
                    sh '''
                        cd sub_managment/users
                        terraform init -reconfigure
                        terraform ${action} -auto-approve 
                    '''
                }
            }
        }
        stage('Terraform - groups') {
            steps {
                script {
                    sh '''
                        cd sub_managment/groups
                        terraform init -reconfigure
                        terraform ${action} -auto-approve 
                    '''
                }
            }
        }
        stage('Terraform - rbac') {
            steps {
                script {
                    sh '''
                        cd sub_managment/rbac
                        terraform init -reconfigure
                        terraform ${action} -auto-approve 
                    '''
                }
            }
        }
        stage('Terraform Apply Flow') {
            when { expression { params.action == 'apply' } }
            
        }

        /* =====================================================
        DESTROY FLOW
        ===================================================== */

        stage('Terraform Destroy Flow') {
            when { expression { params.action == 'destroy' } }
            steps {
                sh '''
                    set -e

                    echo "Running DESTROY flow..."

                    cd sub_managment/rbac
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -

                    cd sub_managment/groups
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -

                    cd sub_managment/users
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -

                    cd envs/prod
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -

                    cd envs/staging
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -

                    cd envs/dev
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -

                    cd backend
                    terraform init -reconfigure
                    terraform destroy -auto-approve
                    cd -
                '''
            }
        }
    }
    post {
        always {
            script {
                // Logout from Azure
                sh 'az logout || true'
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed! Check logs for details.'
        }
    }
}
